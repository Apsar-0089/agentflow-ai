PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@your-cluster.mongodb.net/agentflow_ai?retryWrites=true&w=majority&appName=AgenticAI

# JWT (change to a long random secret in production)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AES-256-GCM encryption key — must be exactly 64 hex chars (32 bytes)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis (optional — in-memory queue fallback used if unavailable)
REDIS_URL=redis://localhost:6379

# AI Keys (optional — deterministic rule engine used if absent)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# OAuth Provider Credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-render-app.onrender.com/api/integrations/oauth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-render-app.onrender.com/api/integrations/oauth/slack/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-render-app.onrender.com/api/integrations/oauth/discord/callback
DISCORD_BOT_TOKEN=
